# Astrobook backend API base URL (with /api/v1 prefix)
VITE_API_BASE_URL=http://192.168.0.200:8080/api/v1

# ImageKit public config — same values as server's IMAGEKIT_PUBLIC_KEY / IMAGEKIT_URL_ENDPOINT
# (safe to expose client-side; only the private key stays server-side)
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
